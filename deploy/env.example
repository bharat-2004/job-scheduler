# Local development secrets. Copy to .env next to compose.yaml (git-ignored) to override the dev defaults.
DB_PASSWORD=jobscheduler-dev
RABBITMQ_PASSWORD=jobscheduler-dev
STORAGE_ACCESS_KEY=jobscheduler
STORAGE_SECRET_KEY=jobscheduler-dev-secret
# HS256 key shared by both API instances; at least 32 bytes.
APP_JWT_SECRET=change-me-local-dev-jwt-secret-0123456789abcdef
